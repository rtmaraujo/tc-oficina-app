  "qtdEstoque": 100
}

### [9] Criar Servico
POST http://35.83.151.56/api/v1/admin/servicos
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "nome": "Troca de Oleo",
  "descricao": "Troca completa",
  "preco": 100.00
}

### [10] Criar Ordem de Servico (status RECEBIDA)
POST http://35.83.151.56/api/v1/admin/ordem
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "clienteCpfCnpj": "17861341011",
  "placaVeiculo": "ABC1234",
  "servicosIds": [1],
  "pecasIds": [1]
}

### [11] Avancar status (RECEBIDA -> EM_DIAGNOSTICO -> AGUARDANDO_APROVACAO)
PUT http://35.83.151.56/api/v1/admin/ordem/1/avanca
Authorization: Bearer {{access_token}}

### [12] Aprovar Orcamento (AGUARDANDO_APROVACAO -> EM_EXECUCAO)
POST http://35.83.151.56/api/v1/admin/ordem/1/aprovar-orcamento
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "aprovado": true,
  "observacoes": "Orcamento aprovado"
}

### [13] Avancar (EM_EXECUCAO -> FINALIZADA -> ENTREGUE)
PUT http://35.83.151.56/api/v1/admin/ordem/1/avanca
Authorization: Bearer {{access_token}}

### [14] Listar OS de um cliente (publico)
GET http://35.83.151.56/api/v1/publico/ordem/cliente/2

### [15] Metricas de tempo medio de execucao (admin)
GET http://35.83.151.56/api/v1/admin/metricas/tempo-execucao
Authorization: Bearer {{access_token}}

